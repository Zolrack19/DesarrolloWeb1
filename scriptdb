--trigger
CREATE OR REPLACE FUNCTION generar_codigo_por_rol()
RETURNS TRIGGER AS $$
DECLARE
  prefijo_actual VARCHAR(10);
  nombre_seq VARCHAR(50);
  secuencia_sql TEXT;
  siguiente_valor INT;
  nuevo_codigo TEXT;
BEGIN

  SELECT r.codigo_prefijo, r.nombre_secuencia
  INTO prefijo_actual, nombre_seq
  FROM rol_colaborador r
  WHERE r.id = NEW.rol_colaborador_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'rol_colaborador con id % no registrada', NEW.categoria_id;
  END IF;

  secuencia_sql := 'SELECT nextval(''' || nombre_seq || ''')';
  EXECUTE secuencia_sql INTO siguiente_valor;

  nuevo_codigo := prefijo_actual || LPAD(siguiente_valor::TEXT, 4, '0');
  NEW.codigo := nuevo_codigo;
  NEW.email := concat(nuevo_codigo, '@123digital.com');
  NEW.contrasena := LPAD(FLOOR(RANDOM() * 900000 + 100000)::TEXT, 8, '0');
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;


CREATE TRIGGER trigger_codigo_por_rol
BEFORE INSERT ON colaborador
FOR EACH ROW
EXECUTE FUNCTION generar_codigo_por_rol();



